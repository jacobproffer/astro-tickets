---
import { getTicketDate, getTickets } from "@utils/sanity";
import Section from "@components/Section.astro";
import TicketGrid from "@components/TicketGrid.astro";

const tickets = await getTickets();
const sortedTickets = tickets.sort(
  (a, b) => getTicketDate(b).getTime() - getTicketDate(a).getTime(),
);

// Show only the 12 most recent tickets on the homepage
const recentTickets = sortedTickets.slice(0, 12);
const totalTickets = tickets.length;
---

<Section headline="Recent" note="stubs from the pile">
  <TicketGrid tickets={recentTickets} />

  <div class="flex flex-wrap items-center justify-between gap-4 border-b-2 border-ink pb-6">
    <p class="label">Showing {recentTickets.length} of {totalTickets} tickets</p>
    <a href="/tickets/" class="btn">View all {totalTickets} tickets →</a>
  </div>
</Section>
