---
import FilterSelect from "@components/FilterSelect.astro";

interface Props {
  theaters: string[];
  years: number[];
  ratings: string[];
}

const { theaters, years, ratings } = Astro.props;
---

<div class="border-2 border-ink bg-ink">
  <label for="searchInput" class="sr-only">Search tickets</label>
  <input
    type="search"
    id="searchInput"
    placeholder="Search by title, theater, rating, price, or date..."
    class="block w-full rounded-none border-b-2 border-ink bg-paper px-4 py-4 text-xl font-semibold placeholder:font-normal placeholder:text-muted focus-visible:outline-offset-[-3px]"
    autocomplete="off"
  />
  <div class="grid grid-cols-2 gap-0.5 md:grid-cols-5">
    <FilterSelect
      id="theaterFilter"
      label="Filter by theater"
      options={[
        { value: "", label: "All theaters" },
        ...theaters.map((t) => ({ value: t, label: t })),
      ]}
    />
    <FilterSelect
      id="yearFilter"
      label="Filter by year"
      options={[
        { value: "", label: "All years" },
        ...years.map((y) => ({ value: y, label: String(y) })),
      ]}
    />
    <FilterSelect
      id="ratingFilter"
      label="Filter by rating"
      options={[
        { value: "", label: "All ratings" },
        ...ratings.map((r) => ({ value: r, label: r })),
      ]}
    />
    <FilterSelect
      id="typeFilter"
      label="Filter by release type"
      options={[
        { value: "", label: "All releases" },
        { value: "new", label: "New releases" },
        { value: "rerelease", label: "Re-releases" },
        { value: "international", label: "International" },
      ]}
    />
    <FilterSelect
      id="sortSelect"
      label="Sort by"
      class="col-span-2 md:col-span-1"
      options={[
        { value: "date-desc", label: "Newest first" },
        { value: "date-asc", label: "Oldest first" },
        { value: "price-desc", label: "Price (high–low)" },
        { value: "price-asc", label: "Price (low–high)" },
        { value: "title", label: "Title (A–Z)" },
      ]}
    />
  </div>
</div>
