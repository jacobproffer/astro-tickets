---
interface Option {
  value: string | number;
  label: string;
}

interface Props {
  id: string;
  label: string;
  options: Option[];
  class?: string;
}

const { id, label, options, class: className } = Astro.props;
---

<select
  id={id}
  aria-label={label}
  class:list={[
    "label w-full min-w-0 rounded-none bg-paper px-4 py-3.5 focus-visible:outline-offset-[-3px]",
    className,
  ]}
>
  {options.map((o) => <option value={o.value}>{o.label}</option>)}
</select>
