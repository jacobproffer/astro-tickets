---
import Container from "@components/Container.astro";

interface Props {
  headline: string;
  headingLevel?: 1 | 2 | 3 | 4 | 5 | 6;
  /** Handwritten note scrawled across the headline. Decorative. */
  note?: string;
  class?: string;
  [key: string]: any;
}

const { headline, headingLevel = 2, note, class: className, ...rest } =
  Astro.props;
const HeadingTag = `h${headingLevel}` as any;
---

<Container as="section" class:list={["pt-16 pb-12 md:pt-24", className]} {...rest}>
  {
    headline && (
      <div class:list={["flex flex-wrap items-end justify-between gap-4 border-b-[3px] border-ink", note ? "pb-9 md:pb-12" : "pb-5"]}>
        <HeadingTag class="display relative text-[clamp(3.5rem,11vw,10rem)]">
          {headline}
          {note && (
            <span
              class="script absolute top-[92%] left-[0.3em] -rotate-[4deg] text-[max(1.5rem,0.28em)] whitespace-nowrap text-orange"
              aria-hidden="true"
            >
              {note}
            </span>
          )}
        </HeadingTag>
        <slot name="actions" />
      </div>
    )
  }
  <slot />
</Container>

