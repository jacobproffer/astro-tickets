---
interface Props {
  href: string;
  isActive?: boolean;
  match?: "exact" | "prefix";
  class?: string;
}

const { href, isActive, match = "prefix", class: className } = Astro.props;
---

<a
  href={href}
  data-match={match}
  class:list={[
    "label relative inline-block py-1 transition-colors hover:text-orange",
    "after:absolute after:inset-x-0 after:-bottom-0.5 after:h-[3px] after:origin-left after:scale-x-0 after:bg-orange after:transition-transform after:duration-300",
    "hover:after:scale-x-100 aria-[current=page]:after:scale-x-100",
    className,
  ]}
  aria-current={isActive ? "page" : undefined}
>
  <slot />
</a>
