---
import TicketShell from "@components/TicketShell.astro";
import { formatDateForStub, formatDateForDateTime } from "@utils/format";

interface Props {
  title: string;
  theater: string;
  time: string;
  price: number;
  rating: string;
  international?: boolean;
  rerelease?: boolean;
  /** Stable seed for the serial and barcode (e.g. the Sanity _id). */
  id?: string;
  /** Heading level for the title; pile copies use a plain element. */
  as?: "h2" | "h3" | "div";
  lift?: boolean;
  enter?: boolean;
  class?: string;
  style?: string;
  [key: string]: any;
}

const {
  title,
  theater,
  time,
  price,
  rating,
  international,
  rerelease,
  id,
  as = "h3",
  ...rest
} = Astro.props;

const hasPrice = price !== undefined && price !== null;
const wholePrice = hasPrice
  ? Number.isInteger(price)
    ? `$${price}`
    : `$${price.toFixed(2)}`
  : "";
const kind = international ? "international" : rerelease ? "rerelease" : "regular";
const badge = international ? "International" : rerelease ? "Re-release" : null;
---

<TicketShell
  title={title}
  seed={id ?? `${title}-${time}`}
  kind={kind}
  titleAs={as}
  {...rest}
>
  <Fragment slot="top">{hasPrice && <>Admit one / ${price.toFixed(2)}</>}</Fragment>
  {badge && <Fragment slot="badge">{badge}</Fragment>}
  <Fragment slot="bottom"><span class="sr-only">Seen at </span>{theater}</Fragment>
  {
    rating && (
      <Fragment slot="rate">
        <span class="sr-only">Rated </span>
        {rating}
      </Fragment>
    )
  }
  {
    time && (
      <time slot="side" datetime={formatDateForDateTime(time)}>
        {formatDateForStub(time)}
      </time>
    )
  }
  {hasPrice && <span slot="big" aria-hidden="true">{wholePrice}</span>}
</TicketShell>
