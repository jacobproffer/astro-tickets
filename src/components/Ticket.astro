---
import {
  formatDateForStub,
  formatDateForDateTime,
  formatPrice,
} from "../utils/format";

interface Props {
  title: string;
  theater: string;
  time: string;
  price: number;
  rating: string;
  international?: boolean;
  rerelease?: boolean;
}

const { title, theater, time, price, rating, international, rerelease } =
  Astro.props;

const getBackgroundColor = () => {
  if (international) return "bg-green";
  if (rerelease) return "bg-blue-100";
  return "bg-white";
};
---

<div class="relative h-full" transition:animate="slide">
  <div
    class={`flex h-full flex-col ${getBackgroundColor()} p-5 border-r border-b border-solid border-black`}
  >
    {
      theater && (
        <div class="label flex items-start justify-between gap-3">
          <div class="pt-px">
            <span class="sr-only">Ticket purchased at</span>
            {theater}
          </div>
          {(international || rerelease) && (
            <span
              class="shrink-0 px-1.5 border border-solid border-black"
              aria-hidden="true"
            >
              {international ? "International" : "Re-release"}
            </span>
          )}
        </div>
      )
    }

    {title && <h3 class="mt-3 mb-6 text-3xl leading-none">{title}</h3>}

    <div class="mt-auto flex items-start justify-between gap-4">
      {
        time && (
          <div class="flex flex-col gap-1">
            <span class="label font-normal">Date</span>
            <time
              datetime={formatDateForDateTime(time)}
              class="label flex h-7 items-center font-semibold tabular-nums"
            >
              <span class="sr-only">Ticket purchased on</span>
              {formatDateForStub(time)}
            </time>
          </div>
        )
      }

      {
        rating && (
          <div class="flex flex-col items-end gap-1">
            <span class="label font-normal">Rated</span>
            <span class="flex h-7 min-w-8 items-center justify-center border border-solid px-1.5 text-xl leading-none">
              <span class="sr-only">The movie is rated</span>
              {rating}
            </span>
          </div>
        )
      }
    </div>

    {
      price !== undefined && price !== null && (
        <div class="mt-4 flex items-baseline gap-2 pt-4 border-t border-solid border-black">
          <span class="label" aria-hidden="true">
            Admit One
          </span>
          <span class="leader" aria-hidden="true" />
          <span class="text-2xl leading-none tabular-nums">
            <span class="sr-only">The ticket cost</span>
            {formatPrice(price)}
          </span>
        </div>
      )
    }
  </div>
</div>
