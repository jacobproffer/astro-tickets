---
import { SEO, type Props as SEOProps } from "astro-seo";
const socialImage = new URL("/images/social.jpg", Astro.site ?? Astro.url).toString();
const socialImageAlt =
  "Deadman's Brew logo above a row of four movie ticket stubs.";

interface Props {
  seo?: SEOProps;
}

const { seo } = Astro.props;

const siteName = "Deadman's Brew";
const siteDescription = "The ongoing movie ticket collection of Jacob Proffer.";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<SEO
  title={seo?.title}
  description={seo?.description ?? siteDescription}
  canonical={canonicalURL}
  openGraph={{
    basic: {
      url: canonicalURL,
      title: seo?.title ?? siteName,
      type: "website",
      image: socialImage,
    },
    image: {
      url: socialImage,
      secureUrl: socialImage,
      alt: socialImageAlt,
      width: 1200,
      height: 630,
    },
  }}
  extend={{
    meta: [
      {
        property: "og:locale",
        content: "en_US",
      },
      {
        property: "og:description",
        content:
          seo?.description ??
          "The ongoing movie ticket collection of Jacob Proffer.",
      },
      {
        property: "og:site_name",
        content: siteName,
      },
      {
        name: "twitter:card",
        content: "summary_large_image",
      },
      {
        name: "twitter:title",
        content: seo?.title ?? "Deadman's Brew",
      },
      {
        name: "twitter:description",
        content: seo?.description ?? siteDescription,
      },
      {
        name: "twitter:image",
        content: socialImage,
      },
      {
        name: "twitter:image:alt",
        content: socialImageAlt,
      },
    ],
  }}
/>
