---
import NavLink from "@components/NavLink.astro";

const links = [
  { href: "/tickets/", label: "All tickets", match: "prefix" },
  { href: "/theaters/", label: "Theaters", match: "prefix" },
  { href: "/ratings/", label: "Ratings", match: "prefix" },
  { href: "/search/", label: "Search", match: "exact" },
] as const;

const currentPath = Astro.url.pathname;
const isActive = (href: string, match: string) =>
  match === "exact" ? currentPath === href : currentPath.startsWith(href);
---

<nav
  aria-label="primary"
  class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 py-4"
>
  <a
    href="/"
    class="hl text-sm transition-colors hover:bg-ink hover:text-paper"
    aria-current={currentPath === "/" ? "page" : undefined}
    data-match="exact"
  >
    Deadman's Brew
  </a>
  <ul class="flex flex-wrap gap-x-5 gap-y-2">
    {
      links.map((link) => (
        <li>
          <NavLink
            href={link.href}
            isActive={isActive(link.href, link.match)}
            match={link.match}
          >
            {link.label}
          </NavLink>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  // The header persists across ClientRouter navigations, so keep
  // aria-current in sync after each swap.
  document.addEventListener("astro:after-swap", () => {
    const path = window.location.pathname;
    document
      .querySelectorAll<HTMLAnchorElement>('nav[aria-label="primary"] a')
      .forEach((link) => {
        const href = link.getAttribute("href") ?? "";
        const active =
          link.dataset.match === "exact"
            ? path === href
            : path.startsWith(href);
        if (active) link.setAttribute("aria-current", "page");
        else link.removeAttribute("aria-current");
      });
  });
</script>
