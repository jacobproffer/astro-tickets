---
import TicketShell from "@components/TicketShell.astro";

interface Props {
  title: string;
  count: number;
  totalCount: number;
  href: string;
  type: "theater" | "rating";
  subtitle?: string;
}

const { title, count, totalCount, href, type } = Astro.props;

const typeLabels = {
  theater: "Movie theater",
  rating: "Movie rating",
};

const actionLabels = {
  theater: "View theater",
  rating: "View rating",
};

const percentage = Math.round((count / totalCount) * 100);
const tickets = count === 1 ? "ticket" : "tickets";
---

<li>
  <TicketShell as="a" href={href} title={title} seed={title} titleAs="h2" lift enter>
    <Fragment slot="top">{typeLabels[type]}</Fragment>
    <span slot="bottom" aria-hidden="true">{actionLabels[type]} →</span>
    <Fragment slot="rate">{percentage}%<span class="sr-only"> of all tickets</span></Fragment>
    <span slot="side" aria-hidden="true">{count} {tickets}</span>
    <Fragment slot="big">{count}<span class="sr-only"> {tickets}</span></Fragment>
  </TicketShell>
</li>
