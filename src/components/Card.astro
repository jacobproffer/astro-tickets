---
import { barcode, serial, splitTitle } from "@utils/ticket";

interface Props {
  title: string;
  count: number;
  totalCount: number;
  href: string;
  type: "theater" | "rating";
  subtitle?: string;
}

const { title, count, totalCount, href, type } = Astro.props;

const typeLabels = {
  theater: "Movie theater",
  rating: "Movie rating",
};

const actionLabels = {
  theater: "View theater",
  rating: "View rating",
};

const percentage = Math.round((count / totalCount) * 100);
const { lead, tail, leadSize, tailSize } = splitTitle(title);
---

<li>
  <a
    href={href}
    class="tk tk-enter tk-lift"
    style={`--bars: ${barcode(title)}`}
  >
    <div class="tk-in">
      <div class="tk-main">
        <div class="tk-row">
          <span>{typeLabels[type]}</span>
          <span aria-hidden="true">{serial(title)}</span>
        </div>
        <div class="tk-rule"></div>
        <h2 class="tk-title">
          <span class="tk-c" style={`font-size:${leadSize}cqw`}>{lead}</span>
          {
            tail && (
              <>
                {" "}
                <span class="tk-x" style={`font-size:${tailSize}cqw`}>{tail}</span>
              </>
            )
          }
        </h2>
        <div class="tk-rule tk-rule-thin"></div>
        <div class="tk-row">
          <span class="tk-theater" aria-hidden="true">{actionLabels[type]} →</span>
          <span class="tk-bars" aria-hidden="true"></span>
        </div>
      </div>
      <div class="tk-stub">
        <span class="tk-hl tk-rate">{percentage}%<span class="sr-only"> of all tickets</span></span>
        <span class="tk-vdate" aria-hidden="true">{count === 1 ? "1 ticket" : `${count} tickets`}</span>
        <span class="tk-price">
          {count}<span class="sr-only">{count === 1 ? " ticket" : " tickets"}</span>
        </span>
      </div>
    </div>
  </a>
</li>
