---
import { getTicketDate, getTickets } from "@utils/sanity";
import BaseLayout from "@layouts/BaseLayout.astro";
import Section from "@components/Section.astro";
import TicketGrid from "@components/TicketGrid.astro";
import FilterBar from "@components/FilterBar.astro";
import ResultsBar from "@components/ResultsBar.astro";

const pageTitle = "Search";
const allTickets = await getTickets();

// Newest first, matching the default sort.
const sortedTickets = allTickets.sort(
  (a, b) => getTicketDate(b).getTime() - getTicketDate(a).getTime(),
);

const unique = <T,>(values: (T | undefined | null)[]) =>
  [...new Set(values.filter((v): v is T => v !== undefined && v !== null && v !== ""))];

const theaters = unique(sortedTickets.map((t) => t.theater)).sort((a, b) =>
  a.localeCompare(b),
);
const years = unique(
  sortedTickets.map((t) => (t.date ? Number(t.date.slice(0, 4)) : undefined)),
).sort((a, b) => b - a);

// MPA ratings in their natural order; anything else (e.g. "NR") follows alphabetically.
const RATING_ORDER = ["G", "PG", "PG-13", "R", "NC-17"];
const ratingRank = (r: string) => {
  const i = RATING_ORDER.indexOf(r);
  return i === -1 ? RATING_ORDER.length : i;
};
const ratings = unique(sortedTickets.map((t) => t.rating)).sort(
  (a, b) => ratingRank(a) - ratingRank(b) || a.localeCompare(b),
);
---

<BaseLayout pageTitle={pageTitle}>
  <Section headline="Search" note="find a stub" headingLevel={1}>
    <FilterBar theaters={theaters} years={years} ratings={ratings} />

    <ResultsBar />

    <TicketGrid id="ticketResults" tickets={sortedTickets} filterable />

    <div
      id="noResults"
      class="bg-paper py-12 text-center"
      hidden
    >
      <h2 class="display mb-3 text-6xl">No tickets found</h2>
      <p class="label">
        Try a different search term or
        <button type="button" id="clearFiltersEmpty" class="underline decoration-orange decoration-2 underline-offset-4">
          clear filters
        </button>
      </p>
    </div>
  </Section>
</BaseLayout>

<script>
  import "../scripts/ticket-filters";
</script>
