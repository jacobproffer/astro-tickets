---
import BaseLayout from "@layouts/BaseLayout.astro";
import Section from "@components/Section.astro";
const pageTitle = "404 - Page Not Found";
---

<BaseLayout pageTitle={pageTitle}>
  <Section headline="404" note="this stub went missing" headingLevel={1}>
    <p class="text-xl">Sorry, the page you are looking for does not exist. <a class="underline decoration-orange decoration-2 underline-offset-4" href="/">Back to the pile</a>.</p>
  </Section>
</BaseLayout>—
